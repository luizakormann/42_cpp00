# **************************************************************************** #
#                               configuration                                  #
# **************************************************************************** #

CC		= c++
CFLAGS	= -Wall -Wextra -Werror -std=c++98
RM		= rm -rf

# **************************************************************************** #
#                                directories                                   #
# **************************************************************************** #

OBJ_DIR	= obj/

# **************************************************************************** #
#                                   files                                      #
# **************************************************************************** #

NAME	= bank
SRC		= Account.cpp tests.cpp
OBJ		= $(addprefix $(OBJ_DIR), $(SRC:.cpp=.o))
HEADERS	= Account.hpp

# **************************************************************************** #
#                              compile commands                                #
# **************************************************************************** #

COMP		= $(CC) $(CFLAGS) $(OBJ) -o $(NAME)
COMP_OBJ	= $(CC) $(CFLAGS) -c $< -o $@

# **************************************************************************** #
#                                  targets                                     #
# **************************************************************************** #

all: $(NAME)
	@echo "compilation completed."

$(OBJ_DIR)%.o: %.cpp $(HEADERS)
	@mkdir -p $(dir $@)
	@$(COMP_OBJ)

$(NAME): $(OBJ)
	@$(COMP)

clean:
	@$(RM) $(OBJ_DIR)

fclean: clean
	@$(RM) $(NAME)

re: fclean all

.PHONY: all clean fclean re
